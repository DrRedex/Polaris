# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# OpenAI key for the standalone agent (Streamlit UI, CLI demo, worked investigation).
# Not needed when you use the MCP server from Claude Desktop / Claude Code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# SereneDB superuser password, seeded by docker compose when the data volume is first created.
SERENEDB_PASSWORD=serenedb
# Override the full connection string if needed (default built from SERENEDB_PASSWORD):
# SERENEDB_DSN=postgresql://postgres:serenedb@127.0.0.1:7890/postgres

# SELECT-only role for guarded LLM-written SQL (execute_guarded_readonly_sql); created by load_corpus.py.
SERENEDB_READER_PASSWORD=log_reader
# SERENEDB_READER_DSN=postgresql://log_reader:log_reader@127.0.0.1:7890/postgres

# Sentence-embedding model for resolve_semantic_schema (downloaded once to the Hugging Face cache).
# SEMANTIC_MODEL=all-MiniLM-L6-v2

# The repo's data/ directory as the SereneDB *server* sees it (docker compose mounts it at /data).
SERENEDB_DATA_DIR=/data
