# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# OpenAI key for the standalone agent (Streamlit UI, CLI demo, worked investigation).
# Not needed when you use the MCP server from Claude Desktop / Claude Code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional USD per 1M tokens; cost remains unavailable unless both are supplied.
# OPENAI_INPUT_PRICE_PER_1M=
# OPENAI_OUTPUT_PRICE_PER_1M=
# Optional scan price used only with footer-derived compressed selected-column byte estimates.
# OTEL_SCAN_PRICE_USD_PER_GB=

# SereneDB superuser password, seeded by docker compose when the data volume is first created.
SERENEDB_PASSWORD=serenedb
# Override the full connection string if needed (default built from SERENEDB_PASSWORD):
# SERENEDB_DSN=postgresql://postgres:serenedb@127.0.0.1:7890/postgres

# SELECT-only role for guarded LLM-written SQL (execute_guarded_readonly_sql); created by load_corpus.py.
SERENEDB_READER_PASSWORD=log_reader
# SERENEDB_READER_DSN=postgresql://log_reader:log_reader@127.0.0.1:7890/postgres

# Role-scoped application connections. Provision with `uv run python scripts/setup_roles.py`.
# Do not point these at the superuser. Configure these separately per role deployment.
# SERENEDB_ENGINEER_DSN=postgresql://engineer_role:<password>@127.0.0.1:7890/postgres
# SERENEDB_TEAM_LEAD_DSN=postgresql://team_lead_role:<password>@127.0.0.1:7890/postgres
# SERENEDB_MANAGER_DSN=postgresql://manager_role:<password>@127.0.0.1:7890/postgres
# SERENEDB_APP_ROLE=engineer  # engineer | team_lead | manager (MCP process policy)
# SERENEDB_ENGINEER_PASSWORD=
# SERENEDB_TEAM_LEAD_PASSWORD=
# SERENEDB_MANAGER_PASSWORD=

# Sentence-embedding model for resolve_semantic_schema (downloaded once to the Hugging Face cache).
# SEMANTIC_MODEL=all-MiniLM-L6-v2

# The repo's data/ directory as the SereneDB *server* sees it (docker compose mounts it at /data).
SERENEDB_DATA_DIR=/data
